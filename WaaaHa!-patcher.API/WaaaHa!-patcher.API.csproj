<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WaaaHa__patcher.API</RootNamespace>
    <AssemblyName>WaaaHa!-patcher</AssemblyName>
    <ApplicationIcon>wwwroot\Orks build.ico</ApplicationIcon>
    <SignAssembly>False</SignAssembly>
    <Authors>seray, Ognov Games</Authors>
    <PackageProjectUrl>https://github.com/seray-orig/WaaaHa-patcher</PackageProjectUrl>
    <RepositoryUrl>https://github.com/seray-orig/WaaaHa-patcher</RepositoryUrl>
    <RepositoryType>github</RepositoryType>
    <NeutralLanguage>ru</NeutralLanguage>
	  <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
	  <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Фронтенд собирается, только если зависимости уже установлены. Иначе сборка и
       тесты бэкенда падали бы из-за отсутствующего node_modules, хотя интерфейс им
       не нужен. -->
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent"
          Condition="Exists('$(MSBuildProjectDirectory)/../WaaaHa!-patcher.React/node_modules')">
    <Exec Command="npm run build --prefix ../WaaaHa!-patcher.React" />

	  <ItemGroup>
	      <Content Remove="wwwroot/**" />
		  <EmbeddedResource Remove="wwwroot/**" />
	      <EmbeddedResource Include="wwwroot/**" />
	  </ItemGroup>
  </Target>

  <!-- А вот тут зависимости обязательны: публикуемое приложение несёт в себе интерфейс,
       и без него выйдет бинарник, который открывается пустым белым экраном. -->
  <Target Name="FailWithoutFrontend" BeforeTargets="ComputeFilesToPublish"
          Condition="!Exists('$(MSBuildProjectDirectory)/../WaaaHa!-patcher.React/node_modules')">
    <Error Text="Сначала выполните 'npm ci --prefix WaaaHa!-patcher.React', иначе приложение опубликуется без интерфейса." />
  </Target>

    <ItemGroup>
      <Content Remove="dotnet-tools.json" />
    </ItemGroup>

    <ItemGroup>
      <None Include="dotnet-tools.json">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Services\Interfaces\" />
    </ItemGroup>

</Project>
